<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.java.controller.TransactionController"
            style="-fx-background-color: #F7F8FA;">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <StackPane prefHeight="100"
                   style="-fx-background-color: white;">

            <Polygon points="0,0, 180,0, 0,100"
                     fill="#12304F"
                     StackPane.alignment="TOP_LEFT"/>

            <Polygon points="180,0, 340,0, 340,100"
                     fill="#C44D08"
                     StackPane.alignment="TOP_RIGHT"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets left="35" right="35"/>
                </padding>

                <ImageView fitWidth="65"
                           fitHeight="65"
                           preserveRatio="true">
                    <image>
                        <Image url="@../images/logoImage.png"/>
                    </image>
                </ImageView>

                <Label text="ROWDY BUDGETEERS"
                       textFill="#12304F">
                    <font>
                        <Font size="20" name="System Bold"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Dashboard"
                        onAction="#showDashboard"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #12304F;
                               -fx-font-weight: bold;
                               -fx-padding: 9 16;"/>

                <Button text="Transactions"
                        style="-fx-background-color: #12304F;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5;
                               -fx-padding: 9 16;"/>

                <Button text="Budgets"
                        onAction="#showBudgets"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #12304F;
                               -fx-font-weight: bold;
                               -fx-padding: 9 16;"/>

                <Button text="Reports"
                        onAction="#showReports"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #12304F;
                               -fx-font-weight: bold;
                               -fx-padding: 9 16;"/>

                <Button text="Logout"
                        onAction="#handleLogout"
                        style="-fx-background-color: #C44D08;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5;
                               -fx-padding: 9 16;"/>
            </HBox>
        </StackPane>
    </top>

    <!-- MAIN TRANSACTION CONTENT -->
    <center>
        <VBox spacing="22">
            <padding>
                <Insets top="35" right="40"
                        bottom="35" left="40"/>
            </padding>

            <!-- PAGE TITLE -->
            <VBox spacing="8">
                <Label text="Transactions"
                       textFill="#12304F">
                    <font>
                        <Font size="28" name="System Bold"/>
                    </font>
                </Label>

                <Label text="Add and manage your purchases."
                       textFill="#666666">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
            </VBox>

            <!-- ADD TRANSACTION SECTION -->
            <VBox spacing="18"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #E2E5E9;
                         -fx-border-radius: 8;
                         -fx-padding: 22;">

                <Label text="Add a Transaction"
                       textFill="#12304F">
                    <font>
                        <Font size="19" name="System Bold"/>
                    </font>
                </Label>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="purchaseNameField"
                               promptText="Purchase name"
                               prefWidth="220"
                               prefHeight="40"/>

                    <ComboBox fx:id="categoryComboBox"
                              promptText="Category"
                              prefWidth="170"
                              prefHeight="40"/>

                    <TextField fx:id="amountField"
                               promptText="Amount"
                               prefWidth="130"
                               prefHeight="40"/>

                    <DatePicker fx:id="purchaseDatePicker"
                                promptText="Purchase date"
                                prefWidth="150"
                                prefHeight="40"/>

                    <Button text="Add Transaction"
                            onAction="#handleAddTransaction"
                            prefHeight="40"
                            style="-fx-background-color: #C44D08;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-padding: 0 18;"/>
                </HBox>

                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       textFill="#666666"/>
            </VBox>

            <!-- TRANSACTION HISTORY SECTION -->
            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #E2E5E9;
                         -fx-border-radius: 8;
                         -fx-padding: 22;">

                <Label text="Transaction History"
                       textFill="#12304F">
                    <font>
                        <Font size="19" name="System Bold"/>
                    </font>
                </Label>

                <TableView fx:id="transactionsTable"
                           prefHeight="350">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>
                        <TableColumn fx:id="transactionIDColumn"
                                     text="Transaction ID"
                                     prefWidth="120"/>

                        <TableColumn fx:id="purchaseColumn"
                                     text="Purchase"
                                     prefWidth="200"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Category"
                                     prefWidth="150"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Date"
                                     prefWidth="150"/>

                        <TableColumn fx:id="amountColumn"
                                     text="Amount"
                                     prefWidth="130"/>
                    </columns>

                    <placeholder>
                        <Label text="Your transactions will appear here."
                               textFill="#777777"/>
                    </placeholder>
                </TableView>

                <!-- TRANSACTION ACTION BUTTONS -->
                <HBox spacing="12">
                    <Button text="Update Selected"
                            onAction="#handleUpdateTransaction"
                            style="-fx-background-color: #12304F;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-padding: 9 16;"/>

                    <Button text="Delete Selected"
                            onAction="#handleDeleteTransaction"
                            style="-fx-background-color: #C44D08;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-padding: 9 16;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>