<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.java.view.MainScreenController"
            style="-fx-background-color: #F7F8FA;">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <StackPane prefHeight="100"
                   style="-fx-background-color: white;">

            <!-- Navy Corner -->
            <Polygon points="0,0, 180,0, 0,100"
                     fill="#12304F"
                     StackPane.alignment="TOP_LEFT"/>

            <!-- Orange Corner -->
            <Polygon points="180,0, 340,0, 340,100"
                     fill="#C44D08"
                     StackPane.alignment="TOP_RIGHT"/>

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <padding>
                    <Insets left="35" right="35"/>
                </padding>

                <!-- Logo -->
                <ImageView fitWidth="65"
                           fitHeight="65"
                           preserveRatio="true">
                    <image>
                        <Image url="@../images/logoImage.png"/>
                    </image>
                </ImageView>

                <!-- Application Name -->
                <Label text="ROWDY BUDGETEERS"
                       textFill="#12304F">
                    <font>
                        <Font size="20" name="System Bold"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Navigation Buttons -->
                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        onAction="#showDashboard"
                        style="-fx-background-color: #12304F;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5;
                               -fx-padding: 9 16;"/>

                <Button fx:id="transactionsButton"
                        text="Transactions"
                        onAction="#showTransactions"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #12304F;
                               -fx-font-weight: bold;
                               -fx-padding: 9 16;"/>

                <Button fx:id="budgetsButton"
                        text="Budgets"
                        onAction="#showBudgets"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #12304F;
                               -fx-font-weight: bold;
                               -fx-padding: 9 16;"/>

                <Button fx:id="reportsButton"
                        text="Reports"
                        onAction="#showReports"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #12304F;
                               -fx-font-weight: bold;
                               -fx-padding: 9 16;"/>

                <Button fx:id="logoutButton"
                        text="Logout"
                        onAction="#handleLogout"
                        style="-fx-background-color: #C44D08;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5;
                               -fx-padding: 9 16;"/>

            </HBox>
        </StackPane>
    </top>

    <!-- MAIN DASHBOARD CONTENT -->
    <center>
        <VBox spacing="22">

            <padding>
                <Insets top="35"
                        right="40"
                        bottom="35"
                        left="40"/>
            </padding>

            <!-- WELCOME SECTION -->
            <VBox spacing="8">

                <Label fx:id="welcomeLabel"
                       text="Welcome Back!"
                       textFill="#12304F">
                    <font>
                        <Font size="28" name="System Bold"/>
                    </font>
                </Label>

                <Label text="Here is an overview of your finances."
                       textFill="#666666">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>

            </VBox>

            <!-- FINANCIAL SUMMARY CARDS -->
            <HBox spacing="18">

                <!-- TOTAL BALANCE -->
                <VBox spacing="12"
                      prefWidth="220"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #E2E5E9;
                             -fx-border-radius: 8;
                             -fx-padding: 22;">

                    <Label text="TOTAL BALANCE"
                           textFill="#666666">
                        <font>
                            <Font size="13" name="System Bold"/>
                        </font>
                    </Label>

                    <Label fx:id="totalBalanceLabel"
                           text="\$5,000.00"
                           textFill="#12304F">
                        <font>
                            <Font size="26" name="System Bold"/>
                        </font>
                    </Label>

                    <Region prefHeight="3"
                            maxHeight="3"
                            style="-fx-background-color: #12304F;
                                   -fx-background-radius: 2;"/>

                </VBox>

                <!-- MONTHLY SPENDING -->
                <VBox spacing="12"
                      prefWidth="220"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #E2E5E9;
                             -fx-border-radius: 8;
                             -fx-padding: 22;">

                    <Label text="MONTHLY SPENDING"
                           textFill="#666666">
                        <font>
                            <Font size="13" name="System Bold"/>
                        </font>
                    </Label>

                    <Label fx:id="monthlySpendingLabel"
                           text="\$1,250.00"
                           textFill="#C44D08">
                        <font>
                            <Font size="26" name="System Bold"/>
                        </font>
                    </Label>

                    <Region prefHeight="3"
                            maxHeight="3"
                            style="-fx-background-color: #C44D08;
                                   -fx-background-radius: 2;"/>

                </VBox>

                <!-- ACTIVE BUDGETS -->
                <VBox spacing="12"
                      prefWidth="220"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #E2E5E9;
                             -fx-border-radius: 8;
                             -fx-padding: 22;">

                    <Label text="ACTIVE BUDGETS"
                           textFill="#666666">
                        <font>
                            <Font size="13" name="System Bold"/>
                        </font>
                    </Label>

                    <Label fx:id="activeBudgetsLabel"
                           text="4"
                           textFill="#12304F">
                        <font>
                            <Font size="26" name="System Bold"/>
                        </font>
                    </Label>

                    <Region prefHeight="3"
                            maxHeight="3"
                            style="-fx-background-color: #12304F;
                                   -fx-background-radius: 2;"/>

                </VBox>

            </HBox>

            <!-- RECENT TRANSACTIONS SECTION -->
            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-color: #E2E5E9;
                         -fx-border-radius: 8;
                         -fx-padding: 20;">

                <Label text="Recent Transactions"
                       textFill="#12304F">
                    <font>
                        <Font size="20" name="System Bold"/>
                    </font>
                </Label>

                <TableView fx:id="transactionsTable"
                           prefHeight="250">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="dateColumn"
                                     text="Date"
                                     prefWidth="150"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Category"
                                     prefWidth="180"/>

                        <TableColumn fx:id="amountColumn"
                                     text="Amount"
                                     prefWidth="150"/>

                        <TableColumn fx:id="descriptionColumn"
                                     text="Description"
                                     minWidth="200"
                                     prefWidth="300"/>

                    </columns>

                    <placeholder>
                        <Label text="Your recent transactions will appear here."
                               textFill="#777777"/>
                    </placeholder>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>