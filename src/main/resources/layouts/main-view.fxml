<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.paint.Color?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="75">

            <padding>
                <Insets left="25" right="25"/>
            </padding>

            <Label text="ROWDY BUDGETEERS">
                <font>
                    <Font size="22" name="System Bold"/>
                </font>
                <textFill>
                    <Color red="0.235" green="0.620" blue="0.678"/>
                </textFill>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Dashboard"/>
            <Button text="Transactions"/>
            <Button text="Budgets"/>
            <Button text="Logout"/>

        </HBox>
    </top>

    <!-- MAIN DASHBOARD CONTENT -->
    <center>
        <VBox spacing="22">

            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <Label text="Welcome Back!">
                <font>
                    <Font size="28" name="System Bold"/>
                </font>
            </Label>

            <Label text="Here is an overview of your finances."/>

            <!-- FINANCIAL SUMMARY CARDS -->
            <HBox spacing="15">

                <VBox spacing="10" prefWidth="220">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="TOTAL BALANCE"/>

                    <Label text="\$5,000.00">
                        <font>
                            <Font size="24" name="System Bold"/>
                        </font>
                        <textFill>
                            <Color red="0.235" green="0.620" blue="0.678"/>
                        </textFill>
                    </Label>
                </VBox>

                <VBox spacing="10" prefWidth="220">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="MONTHLY SPENDING"/>

                    <Label text="\$1,250.00">
                        <font>
                            <Font size="24" name="System Bold"/>
                        </font>
                        <textFill>
                            <Color red="0.235" green="0.620" blue="0.678"/>
                        </textFill>
                    </Label>
                </VBox>

                <VBox spacing="10" prefWidth="220">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="ACTIVE BUDGETS"/>

                    <Label text="4">
                        <font>
                            <Font size="24" name="System Bold"/>
                        </font>
                        <textFill>
                            <Color red="0.235" green="0.620" blue="0.678"/>
                        </textFill>
                    </Label>
                </VBox>

            </HBox>

            <!-- RECENT TRANSACTIONS -->
            <Label text="Recent Transactions">
                <font>
                    <Font size="20" name="System Bold"/>
                </font>
            </Label>

            <TableView prefHeight="250">
                <columns>
                    <TableColumn text="Description" prefWidth="250"/>
                    <TableColumn text="Category" prefWidth="180"/>
                    <TableColumn text="Date" prefWidth="150"/>
                    <TableColumn text="Amount" prefWidth="150"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>